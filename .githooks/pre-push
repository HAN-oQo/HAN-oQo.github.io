#!/bin/sh
# pre-push — push 되는 커밋 트리에 대해 테마/포맷 일관성 검사를 강제한다.
# 활성화: bash tools/install-hooks.sh  (git config core.hooksPath .githooks)
# 통과 못 하면 push 자체가 차단된다. 규약: CLAUDE.md / 로직: tools/check_theme.py

repo_root=$(git rev-parse --show-toplevel) || exit 1

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    # 브랜치 삭제 push 는 검사할 트리가 없음
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
    echo "pre-push: ${local_ref#refs/heads/} ($(git rev-parse --short "$local_sha")) 테마/포맷 검사 중..."
    python3 "$repo_root/tools/check_theme.py" --git "$local_sha" || status=1
    # 갱신일 강제: 원격에 이미 있던 콘텐츠 페이지를 고쳤으면 updated 날짜도 올렸는지 검사
    if [ "$remote_sha" != "0000000000000000000000000000000000000000" ] && [ -n "$remote_sha" ]; then
        python3 "$repo_root/tools/check_theme.py" --bump-check "$remote_sha" "$local_sha" || status=1
    fi
done

if [ "$status" -ne 0 ]; then
    echo ""
    echo "push 차단됨 — 위 위반 사항을 고친 뒤 다시 push 하세요."
    echo "(로컬 전체 검사: python3 tools/check_theme.py)"
fi
exit $status
